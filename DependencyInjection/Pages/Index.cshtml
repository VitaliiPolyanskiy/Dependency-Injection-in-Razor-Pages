@page
@model IndexModel
@inject DependencyInjection.Services.ITimeService TimeService

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Впровадження залежностей</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow-sm p-4">
            <h2 class="mb-4 text-primary">Демонстрація Dependency Injection</h2>
            
            <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item">
                    <strong>Час (через inject):</strong> @TimeService.Time
                </li>
                <li class="list-group-item">
                    <strong>Час (через HttpContext):</strong> @Model.PrintTime()
                </li>
                <li class="list-group-item">
                    <strong>Повідомлення (через конструктор):</strong> @Model.Message1
                </li>
                <li class="list-group-item">
                    <strong>Повідомлення (через [FromServices]):</strong> @Model.Message2
                </li>
            </ul>
        </div>
    </div>
</body>
</html>